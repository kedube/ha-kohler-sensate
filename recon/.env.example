# Copy this file to ".env" (same folder) and fill in your Kohler Konnect login.
# The .env file is git-ignored and never leaves your machine; keep it
# private (chmod 600). discover.py and faucet_probe.py only read; control_test.py
# can run water, and asks before it does.
KONNECT_EMAIL=you@example.com
KONNECT_PASSWORD=your-konnect-password
